# Скопировать в .env и заполнить. Файл .env в git не попадает.

# Домен, на котором висит сервис. Для локальной разработки — localhost.
VM_DOMAIN=localhost

# Образ сервера. Локально не трогать (собирается из исходников).
# На сервере строку переписывает scripts/deploy.sh при каждом деплое —
# по ней же видно, какая версия сейчас работает.
# VM_IMAGE=ghcr.io/<владелец>/vitz-music-server:latest

# База
POSTGRES_DB=vitzmusic
POSTGRES_USER=vitzmusic
POSTGRES_PASSWORD=change-me-db

# Секреты. Сгенерировать: openssl rand -hex 32
VM_JWT_SECRET=change-me-jwt-secret-at-least-32-chars
VM_MEDIA_SIGN_SECRET=change-me-sign-secret-at-least-32-chars

# Первый администратор создаётся при старте, если в базе нет ни одного пользователя.
# После первого входа переменные можно убрать.
VM_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
VM_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# Необязательное
VM_ACCESS_TTL_MINUTES=15
VM_REFRESH_TTL_DAYS=30
VM_SIGN_TTL_SECONDS=21600
VM_UPLOAD_MAX_BYTES=209715200
VM_WORKER_CONCURRENCY=2

# Уборка хранилища. Удалённый трек столько дней лежит в корзине: за это время плеер успевает
# забрать на синхронизации, что трека больше нет. Потом строка и файлы стираются с диска.
VM_TRASH_RETENTION_DAYS=30
# Как часто ходит фоновая уборка. 0 — выключить (тогда чистить только кнопкой в админке).
VM_GC_INTERVAL_MINUTES=360
# Сколько файл без ссылки из базы считается «ещё пишется». Ингест кладёт файл в хранилище
# раньше, чем строку в базу, и меньше часа ставить нельзя — уборка снесёт файл на загрузке.
VM_GC_ORPHAN_GRACE_HOURS=24
