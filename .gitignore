.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
.idea/
*.iml
# Путь к Android SDK свой на каждой машине.
local.properties
.env
# Только каталог медиа в корне проекта. Без ведущей косой черты git применяет шаблон
# на любом уровне вложенности и проглатывает пакет com/vitz/music/media.
/media/
/dist/
*.log

# Ключ подписи релизов открытым текстом не хранится нигде, кроме диска: даже в приватном
# репозитории он оказался бы на чужой машине при каждом деплое (actions/checkout выкладывает
# рабочий каталог на раннер GitHub, а рядом крутятся сторонние экшены).
#
# В историю едет только зашифрованный бэкап keystore/release-key.tar.gpg — см. docs/RELEASES.md.
# Каталог исключается как keystore/*, а не keystore/: из исключённого каталога git не может
# вернуть отдельный файл обратно, он в него просто не заходит.
keystore/*
!keystore/*.gpg
*.jks
*.apk

# Портативный gh для публикации релизов — в истории не нужен.
tools/
