{$VM_DOMAIN:localhost} {
	# Аудио и картинки уже сжаты — жать их повторно бессмысленно и мешает Range.
	encode zstd gzip {
		match {
			header Content-Type application/json*
			header Content-Type text/*
		}
	}

	request_body {
		max_size 250MB
	}

	reverse_proxy server:8080 {
		flush_interval -1
	}
}
